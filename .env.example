# ========================================================
# EDUVERSE AI - ENVIRONMENT CONFIGURATION (FREE TIER)
# ========================================================

# 1. Supabase Authentication & PostgreSQL Database (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 2. Server-Side AI API Integration (Google Gemini Free Tier)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# 3. AI Usage & Rate Limiting (Configurable messages per user per day)
AI_DAILY_MESSAGE_LIMIT=20

# 4. Application URL & Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
